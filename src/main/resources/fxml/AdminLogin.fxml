<?xml version="1.0" encoding="UTF-8"?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      alignment="CENTER" spacing="12" style="-fx-background-color: linear-gradient(to bottom right, #f0f4ff, #e8f0ff);"
      padding="40.0">
    <VBox alignment="CENTER" spacing="12" style="-fx-background-color:white; -fx-padding:24; -fx-background-radius:8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10,0,0,4);">
        <Label text="Administrador - Iniciar Sesión" style="-fx-font-size:18px; -fx-font-weight:700;"/>
        <TextField fx:id="tfUser" promptText="Usuario" prefWidth="300"/>
        <PasswordField fx:id="pf" promptText="Contraseña" prefWidth="300"/>
        <HBox alignment="CENTER" spacing="12">
            <Button fx:id="btnIngresar" text="Ingresar" prefWidth="140"/>
            <Button fx:id="btnVolver" text="Volver" prefWidth="100"/>
        </HBox>
        <Label fx:id="lblInfo" textFill="#d32f2f"/>
    </VBox>
</VBox>
